<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LauncherApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_indigo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimplifyLauncher">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateUnchanged"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.SimplifyLauncher.Home"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/launcher_settings"
            android:taskAffinity="app.simplifymy.launcher.settings"
            android:theme="@style/Theme.SimplifyLauncher" />

        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:label="@string/weather_label"
            android:taskAffinity="app.simplifymy.launcher.weather"
            android:theme="@style/Theme.SimplifyLauncher" />

        <activity-alias android:name=".WeatherTeal" android:targetActivity=".WeatherActivity"
            android:icon="@mipmap/ic_weather_teal" android:label="@string/weather_label"
            android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".WeatherCarbon" android:targetActivity=".WeatherActivity"
            android:icon="@mipmap/ic_weather_carbon" android:label="@string/weather_label"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".WeatherBlue" android:targetActivity=".WeatherActivity"
            android:icon="@mipmap/ic_weather_blue" android:label="@string/weather_label"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".WeatherPurple" android:targetActivity=".WeatherActivity"
            android:icon="@mipmap/ic_weather_purple" android:label="@string/weather_label"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".WeatherMagenta" android:targetActivity=".WeatherActivity"
            android:icon="@mipmap/ic_weather_magenta" android:label="@string/weather_label"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".WeatherGreen" android:targetActivity=".WeatherActivity"
            android:icon="@mipmap/ic_weather_green" android:label="@string/weather_label"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".Indigo" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_indigo" android:label="@string/launcher_entry"
            android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Carbon" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_carbon" android:label="@string/launcher_entry"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Blue" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_blue" android:label="@string/launcher_entry"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Purple" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_purple" android:label="@string/launcher_entry"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Magenta" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_magenta" android:label="@string/launcher_entry"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Teal" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_teal" android:label="@string/launcher_entry"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Green" android:targetActivity=".SettingsActivity"
            android:icon="@mipmap/ic_launcher_green" android:label="@string/launcher_entry"
            android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".PinItemActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SimplifyLauncher.Sheet">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.badges.BadgeListenerService"
            android:exported="true"
            android:label="@string/badges_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".core.actions.LauncherAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
